# Copy to .env and fill in. .env is gitignored — never commit it.
# See SETUP.md for what each key is for, what it costs, and when you can skip one.

# Video: keyframe-pair motion, single-image motion, video edits, upscaling.
# Prepaid credits at dev.runwayml.com — NOT covered by a runwayml.com app subscription.
RUNWAY_API_KEY=

# Images: generating stills and editing approved stills into variants.
# Key from aistudio.google.com/apikey
GEMINI_API_KEY=
